# Postgres. Локально поднимается докером, на проде — Neon.
DATABASE_URL=postgres://dev:dev@localhost:5442/recreate

# Перец для хеша кодов входа и подписи сессий. На проде — длинная случайная строка.
SESSION_SECRET=

# Письма с кодом входа. Без ключа код печатается в консоль сервера.
RESEND_API_KEY=
FROM_EMAIL=info@re-create.art

# PayPlus. Без этих трёх переменных кнопки оплаты картой не показываются.
PAYPLUS_ENV=test
PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_PAGE_UID=

# Часовой пояс студии: в нём считается «сегодня» и в приложении, и в базе.
STUDIO_TZ=Asia/Jerusalem
