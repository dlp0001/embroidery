{
  "name": "re-create-art",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4321",
    "build": "next build",
    "start": "next start -p 4321",
    "migrate": "node --env-file-if-exists=.env.local db/migrate.mjs",
    "seed": "node --env-file-if-exists=.env.local db/seed.mjs",
    "typecheck": "tsc --noEmit",
    "roles": "node --env-file-if-exists=.env.production.local db/grant-roles.mjs",
    "migrate:prod": "node --env-file-if-exists=.env.production.local db/migrate.mjs",
    "payplus:pages": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.production.local scripts/payplus-pages.mjs",
    "verify": "tsc --noEmit && BUILD_DIR=.next-verify next build",
    "families": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.production.local scripts/test-families.mjs",
    "payplus:methods": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.production.local scripts/payplus-methods.mjs",
    "visits": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.production.local scripts/test-visits.mjs",
    "reset:local": "node --env-file-if-exists=.env.local scripts/reset-local.mjs",
    "reset:prod": "node --env-file-if-exists=.env.production.local scripts/reset-local.mjs --allow-remote",
    "payments": "node --env-file-if-exists=.env.local scripts/payment-check.mjs",
    "payments:prod": "node --env-file-if-exists=.env.production.local scripts/payment-check.mjs",
    "icount": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.production.local scripts/icount-check.mjs",
    "email": "node --env-file-if-exists=.env.local scripts/set-email.mjs",
    "email:prod": "node --env-file-if-exists=.env.production.local scripts/set-email.mjs",
    "inventory": "node --env-file-if-exists=.env.local scripts/db-inventory.mjs",
    "inventory:prod": "node --env-file-if-exists=.env.production.local scripts/db-inventory.mjs",
    "children": "node --env-file-if-exists=.env.local scripts/wipe-children.mjs",
    "children:prod": "node --env-file-if-exists=.env.production.local scripts/wipe-children.mjs --allow-remote",
    "sessions": "node --env-file-if-exists=.env.local scripts/wipe-sessions.mjs",
    "sessions:prod": "node --env-file-if-exists=.env.production.local scripts/wipe-sessions.mjs --allow-remote"
  },
  "dependencies": {
    "googleapis": "^140.0.0",
    "next": "^15.5.25",
    "pg": "^8.13.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
