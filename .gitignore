design/studio/re-create-studio.html

.DS_Store
node_modules/
.vercel

.env*.local
next-env.d.ts
tsconfig.tsbuildinfo
# Все каталоги сборки одним правилом: их разводится много
# (.next, .next-verify, .next-check, .next-try, .next-trace), и
# перечислять по одному значит рано или поздно закоммитить сборку.
.next/
.next-*/
# Ни одного файла с ключами: строку дописал vercel link, и она к месту —
# .env.local и .env.production.local не должны попасть в репозиторий
# даже случайно. Шаблон без секретов — исключение.
.env*
!.env.example
